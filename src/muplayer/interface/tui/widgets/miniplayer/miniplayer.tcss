MiniPlayer {
    dock: bottom;
    layout: horizontal;
    width: 100%;
    height: 5;
    padding: 0 2;
    background: $background;
    border-top: solid $surface-lighten-1;
}

/* Now Playing Info Column */
MiniPlayer #now-playing {
    width: 30%;
    height: 100%;
    align: left middle;
}

MiniPlayer #track-art {
    width: 6;
    height: 3;
    margin-right: 2;
    background: $surface-lighten-1;
    color: $primary;
    content-align: center middle;
}

MiniPlayer #track-info {
    layout: vertical;
    height: 100%;
    align: left middle;
}

MiniPlayer #track-title {
    height: 1;
    background: transparent;
    color: $text;
    text-style: bold;
}

MiniPlayer #track-artist {
    height: 1;
    background: transparent;
    color: $text-muted;
    text-style: italic;
}

/* Player Center Controls Column */
MiniPlayer #player-controls {
    layout: vertical;
    width: 40%;
    height: 100%;
    align: center middle;
}

MiniPlayer #control-buttons {
    width: 100%;
    height: 3;
    align: center middle;
}

MiniPlayer Button.control-btn,
MiniPlayer Button.control-btn:focus,
MiniPlayer Button.control-btn:focus:hover {
    min-width: 10;
    height: 3;
    background: transparent;
    color: $text-muted;
    border: none;
    border-top: none;
    border-bottom: none;
}

MiniPlayer Button.control-btn:hover {
    background: transparent;
    color: $text;
    border-top: none;
    border-bottom: none;
}

MiniPlayer Button.play-btn,
MiniPlayer Button.play-btn:focus {
    min-width: 5;
    height: 3;
    background: $foreground;       
    color: $background;
    text-style: bold;
    border: none;
    border-top: none;
    border-bottom: none;
}

MiniPlayer Button.play-btn:hover,
MiniPlayer Button.play-btn:focus:hover {
    background: $primary-lighten-1;
    color: $background;
    border: none;
    border-top: none;
    border-bottom: none;
}

/* Progress Timeline */
MiniPlayer #progress-area {
    width: 100%;
    height: 2;
    align: center middle;
}

MiniPlayer #time-elapsed,
MiniPlayer #time-total {
    width: 5;
    background: transparent;
    color: $text-muted;
    content-align: center middle;
}

MiniPlayer #progress-bar {
    width: 1fr;
    margin: 0 2;
}

MiniPlayer #progress-bar Bar > .bar--complete { color: $text; }
MiniPlayer #progress-bar Bar > .bar--bar      { color: $primary; }

/* Right Section (Volume / Extras Column) */
MiniPlayer #extra-controls {
    width: 30%;
    height: 100%;
    align: right middle;
}

MiniPlayer #repeat-shuffle {
    align: right top;
    width: 100%;
    height: 50%;
}

MiniPlayer Button.icon-btn,
MiniPlayer Button.icon-btn:focus {
    min-width: 4;
    background: transparent;
    color: $text-muted;
    border: none;
    border-top: none;
    border-bottom: none;
}

MiniPlayer Button.icon-btn:hover {
    background: transparent;
    color: $text;
    border-top: none;
    border-bottom: none;
}

MiniPlayer Button.icon-btn.active {
    color: $primary;
    text-style: bold;
    border-top: none;
    border-bottom: none;
}

MiniPlayer #volume-area {
    align: right bottom;
    width: 100%;
    height: 50%;
}

MiniPlayer #volume-icon {
    width: 3;
    background: transparent;
    color: $text-muted;
    content-align: center middle;
}

MiniPlayer #volume-bar {
    width: 1fr;
    margin-left: 1;
}

MiniPlayer #volume-bar Bar > .bar--complete { color: $text; }
MiniPlayer #volume-bar Bar > .bar--bar      { color: $text; }
