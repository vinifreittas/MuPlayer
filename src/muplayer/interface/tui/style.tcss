/* ==========================================================================
   GLOBAL THEME & SCAFFOLDING
   ========================================================================== */
Screen {
    background: $background;
    layout: vertical;
}

#dashboard-view,
#main {
    layout: horizontal;
    width: 100%;
    height: 1fr;
    background: $background;
}

#main-content-switcher {
    width: 1fr;
    height: 100%;
}

/* ==========================================================================
   UTILITIES
   ========================================================================== */
.empty-state {
    text-align: center;
    color: $text-muted;
    padding: 2;
}

.hidden {
    display: none;
}