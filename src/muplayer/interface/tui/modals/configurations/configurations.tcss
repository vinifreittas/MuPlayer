Configurations {
    align: center middle;
    background: transparent;
}

Configurations #container {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: $primary;
}

Configurations #config-header {
    height: auto;
    margin-bottom: 1;
}

Configurations #config-title {
    color: $accent;
    text-style: bold;
    width: 1fr;
    text-align: center;
    margin-top: 0;
}

Configurations #config-close-btn {
    color: $error;
    text-style: bold;
    width: 3;
    text-align: center;
}

Configurations #config-close-btn:hover {
    background: $error;
    color: $text;
}

Configurations Label {
    margin-top: 1;
    text-style: bold;
}

Configurations .toggle-container {
    height: auto;
    align: left middle;
    margin-top: 1;
    margin-bottom: 1;
}

Configurations .toggle-container Label {
    margin-top: 0;
    margin-right: 2;
}
